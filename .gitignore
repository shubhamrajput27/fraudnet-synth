# --- Data: the raw Kaggle file and all generated shards stay local only ---
data/raw/*
data/processed/*
data/clients/**/*.csv
!**/.gitkeep

# --- Secrets ---
.env

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- Models / large artifacts ---
*.pkl
*.pt
*.pth

# --- Node ---
node_modules/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/

# Step 5: LLM response cache (synthetic rows stay inside the bank)
data/clients/**/llm_cache/

# Step 8B demo: bank handover zips and the one-laptop sandbox (never committed)
exports/
*.zip
demo_sandbox/

# Step 10: saved predict model weights and per-bank generation outputs
models/*.pt
data/clients/**/generations/

# Step 12: dashboard build output (rebuild with: cd frontend && npm run build)
frontend/dist/

# Step 14: demo launcher logs
demo/logs/

# Extension E2: saved federated models (rebuilt deterministically by the E2 script)
results/extensions/**/*.pt
