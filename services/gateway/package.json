    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
