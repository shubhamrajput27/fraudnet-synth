# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.

# Groq API key (free tier) — create one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model name — pick a current free-tier model from the Groq console (decided in Step 5)
GROQ_MODEL=

# Local MongoDB (MongoDB Community Server 8.0 is installed and running as a Windows service)
MONGO_URI=mongodb://localhost:27017/fraudnet_synth

# Step 8B multi-laptop demo: the server laptop's IP on the hotspot (find it with ipconfig)
FRAUDNET_SERVER_IP=

# Step 10: shared secret between the Node gateway and the FastAPI orchestrator (>= 16 chars; generate your own)
ORCHESTRATOR_INTERNAL_KEY=

# Step 11: gateway (Tier 2)
GATEWAY_JWT_SECRET=            # >= 32 random characters
GATEWAY_PW_ADMIN=
GATEWAY_PW_BANK_A=
GATEWAY_PW_BANK_B=
GATEWAY_PW_BANK_C=
GATEWAY_PW_BANK_D=
GATEWAY_PW_GUIDE=
GATEWAY_MONGO_URI=mongodb://localhost:27017/fraudnet_gateway   # own database (D-050)
