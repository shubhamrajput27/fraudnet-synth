# Copy to .env and fill in real values. Never commit .env.

# Groq API (free tier) — used only by ml/augmentation/llm_engine for Schema Mode
GROQ_API_KEY=

# MongoDB connection string used by gateway/ for run/round/client/synthetic-batch/validation-report persistence
MONGO_URI=mongodb://localhost:27017/fraudnet_synth

# Secret used by gateway/ to sign JWTs (D9: minimal single-login auth)
JWT_SECRET=

# Global seed for all reproducible random operations (partitioning, training, generation) — default per D5
RANDOM_SEED=42
